**/.DS_Store
**/node_modules
**/*.tsbuildinfo

# Generated TypeScript declaration files for config files
*.config.d.ts
**/build
**/dist
**/.rslib
**/.artifacts
**/.turbo
**/.coverage
**/.vitest
**/.cache
coverage/
**/*.asc
pnpm-publish-summary.json
pnpm-release.json
.changeset/status.json

# Environment files (keep .example files committed)
.env
.env.local
.env.development
.env.production
.env.test
.env.workflow
.env.workflow-cli
!.env.example
!.env.*.example

# Plugin build artifacts
sites/*/lib/models/
sites/*/docs/api/
sites/*/docs/*/api/
sites/*/.rspress/

# Claude AI files
.claude/settings.local.json
.claude/plans/
.claude/plugins-debug.log
.claude/cache/
.playwright-mcp
docs/superpowers
.mcp.json
# dogfood mailbox (silk dogfood loops)
.claude/dogfood/

# Ephemeral plugin observability artifacts (issues.json, trace JSONL)
.api-docs/

# Stray nested .claude/ directories. Tooling occasionally writes one inside a
# workspace (one appeared under platforms/rspress/src/ during Chunk 0 and was
# then removed by a lint-staged untracked-file stash, silently). The only
# .claude/ this repo tracks is the one at the root, which the rules above
# manage; anything nested is tool output and must not be committable.
# The leading `*/` keeps the root directory out of the match.
*/**/.claude/
.claude/handoffs/
