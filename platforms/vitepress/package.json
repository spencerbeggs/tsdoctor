{
	"name": "vitepress-plugin-api-extractor",
	"version": "0.2.0",
	"private": true,
	"description": "VitePress adapter for generating API documentation from TypeScript API Extractor models: markdown pages over the @tsdoctor/pages IR, a sidebar from its navigation tree, and Twoslash type-checking over the same virtual file system the RSPress plugin resolves.",
	"keywords": ["vitepress", "plugin", "api-extractor", "documentation", "typescript", "twoslash"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/tsdoctor/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "platforms/vitepress"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/markdown": "catalog:effected",
		"@effected/package-json": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/tsconfig-json": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"@microsoft/api-extractor-model": "^7.33.11",
		"@shikijs/twoslash": "^4.4.3",
		"@shikijs/vitepress-twoslash": "^4.4.3",
		"@tsdoctor/bundle": "workspace:*",
		"@tsdoctor/manifest": "workspace:*",
		"@tsdoctor/model": "workspace:*",
		"@tsdoctor/pages": "workspace:*",
		"@tsdoctor/registry": "workspace:*",
		"@tsdoctor/seo": "workspace:*",
		"@tsdoctor/vfs": "workspace:*",
		"effect": "catalog:effect",
		"image-size": "^2.0.2",
		"shiki": "^4.4.3",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@savvy-web/bundler": "^2.2.1",
		"@types/node": "catalog:build",
		"vitepress": "2.0.0-alpha.19"
	},
	"peerDependencies": {
		"vitepress": "^2.0.0-alpha.19"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
