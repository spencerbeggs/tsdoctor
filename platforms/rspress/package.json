{
	"name": "rspress-plugin-api-extractor",
	"version": "0.21.1",
	"private": true,
	"description": "RSPress plugin for generating API documentation from TypeScript API Extractor models",
	"keywords": ["rspress", "plugin", "api-extractor", "documentation", "typescript"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "platforms/rspress"
	},
	"license": "MIT",
	"author": "Spencer Beggs",
	"type": "module",
	"exports": {
		".": {
			"effected-built": "./dist/prod/npm/pkg/index.js",
			"default": "./src/index.ts"
		},
		"./env": {
			"types": "./src/env.d.ts"
		},
		"./runtime": {
			"effected-built": "./dist/prod/npm/pkg/runtime/index.js",
			"default": "./src/runtime/index.tsx"
		},
		"./tsconfig/rspress.json": "./public/tsconfig/rspress.json"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effected:exact",
		"@effected/commands": "catalog:effected:exact",
		"@effected/config-file": "catalog:effected:exact",
		"@effected/crypto": "catalog:effected:exact",
		"@effected/files": "catalog:effected:exact",
		"@effected/github": "catalog:effected:exact",
		"@effected/github-references": "catalog:effected:exact",
		"@effected/glob": "catalog:effected:exact",
		"@effected/images": "catalog:effected:exact",
		"@effected/jsonc": "catalog:effected:exact",
		"@effected/jwt": "catalog:effected:exact",
		"@effected/kit": "catalog:effected:exact",
		"@effected/manifest": "catalog:effected:exact",
		"@effected/markdown": "catalog:effected:exact",
		"@effected/memfs": "catalog:effected:exact",
		"@effected/npm": "catalog:effected:exact",
		"@effected/oidc": "catalog:effected:exact",
		"@effected/package-json": "catalog:effected:exact",
		"@effected/pnpm": "catalog:effected:exact",
		"@effected/schema-org": "catalog:effected:exact",
		"@effected/semver": "catalog:effected:exact",
		"@effected/source": "catalog:effected:exact",
		"@effected/spdx": "catalog:effected:exact",
		"@effected/store": "catalog:effected:exact",
		"@effected/tsconfig-json": "catalog:effected:exact",
		"@effected/walker": "catalog:effected:exact",
		"@effected/xdg": "catalog:effected:exact",
		"@effected/yaml": "catalog:effected:exact",
		"@microsoft/api-extractor-model": "catalog:effected:build",
		"@shikijs/twoslash": "^4.6.0",
		"@tsdoctor/bundle": "workspace:*",
		"@tsdoctor/model": "workspace:*",
		"@tsdoctor/pages": "workspace:*",
		"@tsdoctor/registry": "workspace:*",
		"@tsdoctor/seo": "workspace:*",
		"@tsdoctor/snapshot": "workspace:*",
		"@tsdoctor/vfs": "workspace:*",
		"@typescript/vfs": "^1.6.6",
		"clsx": "^2.1.1",
		"effect": "catalog:effected:exact",
		"hast-util-to-jsx-runtime": "^2.3.7",
		"mdast-util-to-hast": "^13.2.1",
		"open": "^11.0.0",
		"prettier": "^3.10.1",
		"react-markdown": "^10.1.0",
		"shiki": "^4.6.0",
		"typescript": "^6.0.3",
		"unist-util-visit": "^5.2.0"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@microsoft/tsdoc": "~0.17.0",
		"@rspress/core": "catalog:docs",
		"@tsdown/css": "^0.23.7",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "catalog:effected:build",
