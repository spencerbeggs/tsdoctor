{
	"name": "rspress-plugin-api-extractor",
	"version": "0.13.1",
	"private": true,
	"description": "RSPress plugin for generating API documentation from TypeScript API Extractor models",
	"keywords": ["rspress", "plugin", "api-extractor", "documentation", "typescript"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "platforms/rspress"
	},
	"license": "MIT",
	"author": "Spencer Beggs",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./env": {
			"types": "./src/env.d.ts"
		},
		"./runtime": "./src/runtime/index.tsx",
		"./tsconfig/rspress.json": "./public/tsconfig/rspress.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/github": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/npm": "catalog:effected",
		"@effected/package-json": "catalog:effected",
		"@effected/semver": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/tsconfig-json": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@microsoft/api-extractor-model": "^7.33.11",
		"@shikijs/twoslash": "^4.4.3",
		"@tsdoctor/bundle": "workspace:*",
		"@tsdoctor/model": "workspace:*",
		"@tsdoctor/registry": "workspace:*",
		"@tsdoctor/seo": "workspace:*",
		"@tsdoctor/snapshot": "workspace:*",
		"@typescript/vfs": "^1.6.4",
		"clsx": "^2.1.1",
		"effect": "catalog:effect",
		"hast-util-to-jsx-runtime": "^2.3.6",
		"image-size": "^2.0.2",
		"ioredis": "^5.7.0",
		"mdast-util-to-hast": "^13.2.1",
		"open": "^11.0.0",
		"prettier": "^3.9.6",
		"react-markdown": "^10.1.0",
		"shiki": "^4.4.3",
		"typescript": "^6.0.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@effected/memfs": "catalog:effected",
		"@microsoft/tsdoc": "^0.16.0",
		"@rspress/core": "catalog:docs",
		"@savvy-web/rspress-builder": "^1.1.29",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "catalog:build",
		"@types/react": "catalog:build",
		"@types/react-dom": "catalog:build",
		"@types/unist": "^3.0.3",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-mdx-jsx": "^3.2.0",
		"react": "catalog:build",
		"react-dom": "catalog:build",
		"unified": "^11.0.5"
	},
	"peerDependencies": {
		"@rspress/core": "catalog:docs:peers",
		"react": "catalog:docs:peers",
		"react-dom": "catalog:docs:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
