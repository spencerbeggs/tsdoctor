		"mdast-util-mdx-jsx": "^3.2.1",
		"react": "catalog:effected:build",
		"react-dom": "catalog:effected:build",
		"unified": "^11.0.5"
	},
	"peerDependencies": {
		"@rspress/core": "^2.1.1",
		"react": "catalog:effected:build:peers",
		"react-dom": "catalog:effected:build:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
