"---
title: Pipeline | Class | API
description: A strongly-typed data pipeline that connects a DataSource to a Transform and manages execution lifecycle.
---

import { SourceCode } from "@rspress/core/theme";
import { ParametersTable } from "rspress-plugin-api-extractor/runtime";
import { ApiSignature, ApiMember, ApiExample } from "rspress-plugin-api-extractor/runtime";

# Pipeline

A strongly-typed data pipeline that connects a DataSource to a Transform and manages execution lifecycle.

<ApiSignature code={"class Pipeline {\\n    constructor(source: DataSource<In>, transform: Transform<In, Out>, options?: PipelineOptions);\\n    static create<I, O>(source: DataSource<I>, transform: Transform<I, O>, options?: PipelineOptions): Pipeline<I, O>;\\n    get batchSize(): number;\\n\\nset batchSize(value: number);\\n    get status(): PipelineStatus;\\n    execute(input: In): Promise<Out>;\\n    parallel(inputs: In[]): Promise<Out[]>;\\n    process(input: In): Out;\\n}"} source={"class Pipeline {\\n    constructor(source: DataSource<In>, transform: Transform<In, Out>, options?: PipelineOptions);\\n    static create<I, O>(source: DataSource<I>, transform: Transform<I, O>, options?: PipelineOptions): Pipeline<I, O>;\\n    get batchSize(): number;\\n\\nset batchSize(value: number);\\n    get status(): PipelineStatus;\\n    execute(input: In): Promise<Out>;\\n    parallel(inputs: In[]): Promise<Out[]>;\\n    process(input: In): Out;\\n}"} apiScope={"kitchensink"} />

## Constructors

<ApiMember code={"constructor(source: DataSource<In>, transform: Transform<In, Out>, options?: PipelineOptions);"} source={"class Pipeline {\\nconstructor(source: DataSource<In>, transform: Transform<In, Out>, options?: PipelineOptions);\\n}"} apiScope={"kitchensink"} memberName="constructor" summary={"Creates a new \`Pipeline\` with the given source, transform, and options."} id={"constructor"} hasParameters={true} />

<ParametersTable parameters={[{"name":"source","type":"DataSource<In>","description":"The DataSource that supplies input records."},{"name":"transform","type":"Transform<In, Out>","description":"The Transform applied to each input record."},{"name":"options","type":"PipelineOptions","description":"Optional PipelineOptions to configure batch size, retry behaviour, and timeout."}]} />

## Static Methods

<ApiMember code={"static create<I, O>(source: DataSource<I>, transform: Transform<I, O>, options?: PipelineOptions): Pipeline<I, O>;"} source={"class Pipeline {\\nstatic create<I, O>(source: DataSource<I>, transform: Transform<I, O>, options?: PipelineOptions): Pipeline<I, O>;\\n}"} apiScope={"kitchensink"} memberName={"create"} summary={"Creates a new \`Pipeline\` from a source and transform with full type inference on the generic parameters."} id={"create"} hasParameters={true} />

<ParametersTable parameters={[{"name":"source","type":"DataSource<I>","description":"A DataSource instance that supplies raw records."},{"name":"transform","type":"Transform<I, O>","description":"A Transform function that converts each \`I\` to \`O\`."},{"name":"options","type":"PipelineOptions","description":"Optional PipelineOptions for pipeline configuration."}]} />

**Returns:** A fully configured \`Pipeline<I, O>\` ready to execute.

## Properties

<ApiMember code={"get batchSize(): number;\\n\\nset batchSize(value: number);"} source={"class Pipeline {\\nget batchSize(): number;\\n\\nset batchSize(value: number);\\n}"} apiScope={"kitchensink"} memberName={"batchSize"} summary={"The maximum number of records accumulated before a batch is flushed."} id={"batchsize"} />

<ApiMember code={"get status(): PipelineStatus;"} source={"class Pipeline {\\nget status(): PipelineStatus;\\n}"} apiScope={"kitchensink"} memberName={"status"} summary={"The current execution state of this pipeline."} id={"status"} />

## Methods

<ApiMember code={"execute(input: In): Promise<Out>;"} source={"class Pipeline {\\nexecute(input: In): Promise<Out>;\\n}"} apiScope={"kitchensink"} memberName={"execute"} summary={"Asynchronously executes the pipeline transform for a single input record, managing the full execution lifecycle."} id={"execute"} hasParameters={true} />

<ParametersTable parameters={[{"name":"input","type":"In","description":"The input record to process."}]} />

**Returns:** A promise that resolves with the transformed output.

<ApiMember code={"parallel(inputs: In[]): Promise<Out[]>;"} source={"class Pipeline {\\nparallel(inputs: In[]): Promise<Out[]>;\\n}"} apiScope={"kitchensink"} memberName={"parallel"} summary={"Executes the pipeline transform over an array of inputs concurrently, returning a promise that resolves with all outputs in input order."} id={"parallel"} hasParameters={true} />

<ParametersTable parameters={[{"name":"inputs","type":"In[]","description":"An array of input records to process in parallel."}]} />

**Returns:** A promise that resolves with an array of transformed outputs in the same order as \`inputs\`.

<ApiMember code={"process(input: In): Out;"} source={"class Pipeline {\\nprocess(input: In): Out;\\n}"} apiScope={"kitchensink"} memberName={"process"} summary={"Synchronously applies the pipeline transform to a single input and returns the output."} id={"process"} hasParameters={true} />

<ParametersTable parameters={[{"name":"input","type":"In","description":"The input record to transform."}]} />

**Returns:** The transformed output record.

## Examples

<ApiExample code={"import { Pipeline, JsonSource, PipelineStatus } from \\"kitchensink\\";\\n\\nconst source = new JsonSource(\\"./data/records.json\\");\\nconst pipeline = Pipeline.create(source, (record) => ({\\n  ...record,\\n  processed: true,\\n}));\\n\\nconst result = await pipeline.execute({ id: 1, name: \\"example\\" });\\nconsole.log(pipeline.status); // PipelineStatus.Completed\\nconsole.log(result); // { id: 1, name: \\"example\\", processed: true }"} source={"// @noErrors\\nimport { Pipeline, JsonSource, PipelineStatus } from \\"kitchensink\\";\\n\\nconst source = new JsonSource(\\"./data/records.json\\");\\nconst pipeline = Pipeline.create(source, (record) => ({\\n  ...record,\\n  processed: true,\\n}));\\n\\nconst result = await pipeline.execute({ id: 1, name: \\"example\\" });\\nconsole.log(pipeline.status); // PipelineStatus.Completed\\nconsole.log(result); // { id: 1, name: \\"example\\", processed: true }"} apiScope={"kitchensink"} />

<ApiExample code={"import { Pipeline, JsonSource } from \\"kitchensink\\";\\n\\n// Configure batch size via options\\nconst source = new JsonSource(\\"./data/items.json\\");\\nconst pipeline = Pipeline.create(source, (item) => String(item), {\\n  batchSize: 50,\\n  retryCount: 2,\\n  timeout: 5000,\\n});\\n\\npipeline.batchSize = 25;\\nconsole.log(pipeline.batchSize); // 25"} source={"// @noErrors\\nimport { Pipeline, JsonSource } from \\"kitchensink\\";\\n\\n// Configure batch size via options\\nconst source = new JsonSource(\\"./data/items.json\\");\\nconst pipeline = Pipeline.create(source, (item) => String(item), {\\n  batchSize: 50,\\n  retryCount: 2,\\n  timeout: 5000,\\n});\\n\\npipeline.batchSize = 25;\\nconsole.log(pipeline.batchSize); // 25"} apiScope={"kitchensink"} />

## See Also

- DataSource for implementing a custom data source.
- Transform for the transformation function interface.
- PipelineOptions for available configuration options.

"
`;

