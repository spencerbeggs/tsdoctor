exports[`multi-entry rendering > renders an "Available from" line when an item is exported from several entry points 1`] = `
"---
title: createPipeline | Function | API
description: Creates a new Pipeline connecting a data source to a transform function.
---

import { SourceCode } from "@rspress/core/theme";
import { ParametersTable } from "rspress-plugin-api-extractor/runtime";
import { ApiSignature, ApiExample } from "rspress-plugin-api-extractor/runtime";

# createPipeline

Creates a new Pipeline connecting a data source to a transform function.

Available from: \`kitchensink\`, \`kitchensink/testing\`

<ApiSignature code={"function createPipeline<I, O>(source: DataSource<I>, transform: Transform<I, O>, options?: PipelineOptions): Pipeline<I, O>;"} source={"function createPipeline<I, O>(source: DataSource<I>, transform: Transform<I, O>, options?: PipelineOptions): Pipeline<I, O>;"} apiScope={"kitchensink"} hasParameters={true} />

<ParametersTable parameters={[{"name":"source","type":"DataSource<I>","description":"The DataSource that supplies raw input records."},{"name":"transform","type":"Transform<I, O>","description":"The Transform applied to each input record."},{"name":"options","type":"PipelineOptions","description":"Optional PipelineOptions controlling batch size, retry count, and timeout behaviour."}]} />

## Returns

A fully configured \`Pipeline<I, O>\` ready to execute.

## Examples

<ApiExample code={"import { createPipeline, JsonSource } from \\"kitchensink\\";\\n\\nconst pipeline = createPipeline(\\n  new JsonSource(\\"./data/records.json\\"),\\n  (record: Record<string, unknown>) => ({ ...record, processed: true }),\\n  { batchSize: 50, retryCount: 2 }\\n);\\n\\nconst result = await pipeline.execute({ id: 1 });\\nconsole.log(result); // { id: 1, processed: true }"} source={"// @noErrors\\nimport { createPipeline, JsonSource } from \\"kitchensink\\";\\n\\nconst pipeline = createPipeline(\\n  new JsonSource(\\"./data/records.json\\"),\\n  (record: Record<string, unknown>) => ({ ...record, processed: true }),\\n  { batchSize: 50, retryCount: 2 }\\n);\\n\\nconst result = await pipeline.execute({ id: 1 });\\nconsole.log(result); // { id: 1, processed: true }"} apiScope={"kitchensink"} />

"
`;

