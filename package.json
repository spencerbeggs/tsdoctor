{
	"name": "tsdoctor-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "The tsdoctor monorepo: tools for generating API documentation from TypeScript API Extractor models",
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build:dev build:prod --log-order=grouped --output-logs=full --log-prefix=none",
		"build:basic": "turbo run build:dev build:prod --filter=@sites/basic --ui=stream",
		"build:multi": "turbo run build:dev build:prod --filter=@sites/multi --ui=stream",
		"build:vitepress-basic": "turbo run build --filter=@sites/vitepress-basic --ui=stream",
		"ci:build": "CI=\"true\" turbo run build:dev build:prod --filter=!@sites/* --filter=!@modules/* --log-order=grouped --output-logs=full --log-prefix=none",
		"ci:test": "CI=\"true\" vitest run --coverage",
		"claude": "claude --plugin-dir=plugin",
		"dev": "turbo run dev --filter=@sites/basic",
		"dev:basic": "turbo run dev --filter=@sites/basic",
		"dev:effect": "turbo run dev --filter=@sites/effect",
		"dev:i18n": "turbo run dev --filter=@sites/i18n",
		"dev:multi": "turbo run dev --filter=@sites/multi",
		"dev:versioned": "turbo run dev --filter=@sites/versioned",
		"dev:vitepress-basic": "turbo run dev --filter=@sites/vitepress-basic",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 '**/*.{md,mdx}' --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2  --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"preview": "turbo run preview --filter=@sites/basic",
		"preview:basic": "turbo run preview --filter=@sites/basic",
		"preview:effect": "turbo run preview --filter=@sites/effect",
		"preview:i18n": "turbo run preview --filter=@sites/i18n",
		"preview:multi": "turbo run preview --filter=@sites/multi",
		"preview:versioned": "turbo run preview --filter=@sites/versioned",
		"preview:vitepress-basic": "turbo run preview --filter=@sites/vitepress-basic",
		"test": "vitest run",
		"test:bats": "bats --recursive plugin",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@okfit/plugin": "^0.4.2",
		"@savvy-web/silk": "^4.2.2",
		"@vitest-agent/plugin": "^4.1.1"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
			"onFail": "warn"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.9.0",
				"onFail": "ignore"
			}
		]
	}
}
