{
	"integration": {
		"ci": {
			"enabled": true,
			"syncOnMerge": false,
			"validateOnPR": true
		},
		"git": {
			"requireReviewForChanges": false,
			"trackDesignDocs": true
		},
		"plans": {
			"autoSyncProgress": false,
			"bidirectionalLinking": true,
			"cacheMetadata": true,
			"cacheTTL": 300,
			"enabled": true,
			"validateOnCommit": true
		}
	},
	"modules": {
		"rspress-plugin-api-extractor": {
			"categories": [
				"architecture",
				"performance",
				"observability",
				"cross-linking",
				"import-generation",
				"source-mapping",
				"meta"
			],
			"designDocsPath": ".claude/design/rspress-plugin-api-extractor",
			"maintainer": "Spencer Beggs",
			"path": "package",
			"userDocs": {
				"readme": "package/README.md",
				"repoDocs": null,
				"siteDocs": null
			}
		}
	},
	"paths": {
		"context": "CLAUDE.md",
		"designDocs": ".claude/design",
		"localContext": "CLAUDE.local.md",
		"plans": ".claude/plans",
		"skills": ".claude/skills"
	},
	"project": {
		"maintainer": "C. Spencer Beggs",
		"name": "spencerbeggs/tsdoctor",
		"repository": "https://github.com/spencerbeggs/tsdoctor",
		"type": "monorepo"
	},
	"quality": {
		"context": {
			"childMaxLines": 300,
			"requireDesignDocPointers": true,
			"rootMaxLines": 500
		},
		"designDocs": {
			"maxLineLength": 120,
			"minSections": ["Overview", "Current State", "Rationale"],
			"requireFrontmatter": true,
			"requireTOC": true
		},
		"plans": {
			"archiveAfterDays": 30,
			"maxLineLength": 120,
			"progressRange": [0, 100],
			"requiredFields": ["name", "title", "created", "status", "progress"],
			"requireFrontmatter": true,
			"stalenessThresholdDays": 30,
			"validStatuses": ["ready", "in-progress", "blocked", "completed", "abandoned"]
		},
		"userDocs": {
			"level1": {
				"maxLineLength": 80,
				"requireSections": ["Features", "Installation", "Usage"],
				"targetWordCount": [200, 500]
			},
			"level2": {
				"maxLineLength": 120,
				"requireNavigation": true
			},
			"level3": {
				"framework": "rspress",
				"requireCodeExamples": true,
				"requireMetadata": true
			}
		}
	},
	"skills": {
		"baseNamespace": "/",
		"enabled": [
			"design-init",
			"design-validate",
			"design-update",
			"design-archive",
			"design-link",
			"design-search",
			"design-compare",
			"design-sync",
			"design-audit",
			"design-report",
			"plan-validate",
			"plan-create",
			"plan-list",
			"plan-complete",
			"plan-explore",
			"docs-generate-readme",
			"docs-generate-repo",
			"docs-generate-site",
			"docs-sync",
			"docs-review",
			"context-review",
			"context-update",
			"context-split",
			"context-validate",
			"context-audit"
		]
	},
	"subagents": {
		"context-doc-agent": {
			"description": "Maintain lean, effective CLAUDE.md files for AI agent context",
			"enabled": true,
			"file": ".claude/agents/context-doc-agent.md",
			"skills": ["context-validate", "context-audit", "context-review", "context-update", "context-split"],
			"tools": ["Read", "Grep", "Glob", "Bash"]
		},
		"design-doc-agent": {
			"description": "Maintain internal design documentation and implementation plans",
			"enabled": true,
			"file": ".claude/agents/design-doc-agent.md",
			"skills": [
				"design-validate",
				"design-init",
				"design-update",
				"design-sync",
				"design-prune",
				"design-review",
				"design-audit",
				"design-search",
				"design-index",
				"design-export",
				"design-compare",
				"design-link",
				"design-report",
				"design-archive",
				"design-config",
				"plan-validate",
				"plan-create",
				"plan-list",
				"plan-complete",
				"plan-explore"
			],
			"tools": ["Read", "Grep", "Glob", "Edit", "Write", "Bash"]
		},
		"docs-gen-agent": {
			"description": "Generate user-facing documentation from design docs",
			"enabled": true,
			"file": ".claude/agents/docs-gen-agent.md",
			"skills": ["docs-generate-readme", "docs-generate-repo", "docs-generate-site", "docs-sync", "docs-review"],
			"tools": ["Read", "Grep", "Glob", "Edit", "Write"]
		},
		"rspress-doc-agent": {
			"description": "Write and maintain RSPress 2.0 documentation sites",
			"enabled": true,
			"file": ".claude/agents/rspress-doc-agent.md",
			"skills": [
				"rspress-page",
				"rspress-nav",
				"rspress-frontmatter",
				"rspress-components",
				"rspress-api-docs",
				"rspress-examples",
				"rspress-guide",
				"rspress-navigation",
				"rspress-review",
				"rspress-sync"
			],
			"tools": ["Read", "Grep", "Glob", "Edit", "Write", "Bash"]
		}
	},
	"version": "1.0.0"
}
