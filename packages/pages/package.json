{
	"name": "@tsdoctor/pages",
	"version": "0.5.5",
	"private": true,
	"description": "Framework-neutral documentation page IR for static TypeScript API sites: typed doc blocks over an API Extractor model, per-API navigation trees, display/source code preparation, a plain-markdown emitter and the llms.txt text transforms.",
	"keywords": ["api-extractor", "tsdoc", "documentation", "markdown", "mdast", "llms", "typescript", "effect"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/tsdoctor/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "packages/pages"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"effected-built": "./dist/prod/npm/pkg/index.js",
			"default": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@microsoft/api-extractor-model": "catalog:effected:build",
		"@tsdoctor/model": "workspace:*",
		"@tsdoctor/seo": "workspace:*",
		"prettier": "^3.10.0"
	},
	"devDependencies": {
		"@effected/glob": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/package-json": "catalog:effected",
		"@effected/schema-org": "catalog:effected",
		"@effected/tsconfig-json": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"effect": "catalog:effected",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@effected/markdown": "catalog:effected:peers",
		"@effected/package-json": "catalog:effected:peers",
		"@effected/schema-org": "catalog:effected:peers",
		"@effected/tsconfig-json": "catalog:effected:peers",
		"effect": "catalog:effected:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
