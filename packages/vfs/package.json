{
	"name": "@tsdoctor/vfs",
	"version": "0.1.0",
	"private": true,
	"description": "Virtual TypeScript projects for documentation tooling: the Vfs currency type, declaration-backed virtual packages, @typescript/vfs environments, and the compiler-option resolution that configures them.",
	"keywords": ["typescript", "vfs", "twoslash", "declarations", "virtual-package", "effect"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/tsdoctor/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "packages/vfs"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@effected/memfs": "catalog:effected",
		"@effected/tsconfig-json": "catalog:effected",
		"@savvy-web/bundler": "^2.1.29",
		"@shikijs/twoslash": "^4.4.3",
		"@types/node": "catalog:build",
		"@typescript/vfs": "^1.6.4",
		"effect": "catalog:effect",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@effected/tsconfig-json": "catalog:effected",
		"@shikijs/twoslash": "^4.4.3",
		"@typescript/vfs": "^1.6.4",
		"effect": "catalog:effect",
		"typescript": "^6.0.3"
	},
	"peerDependenciesMeta": {
		"@shikijs/twoslash": {
			"optional": true
		},
		"@typescript/vfs": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
