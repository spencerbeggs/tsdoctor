{
	"name": "@tsdoctor/registry",
	"version": "0.3.2",
	"private": true,
	"description": "External TypeScript type loading for Effect: fetch, cache and resolve type definitions from npm via the jsDelivr CDN into a virtual file system.",
	"keywords": ["typescript", "vfs", "twoslash", "types", "jsdelivr", "cache", "effect"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/tsdoctor/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "packages/registry"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@tsdoctor/vfs": "workspace:*"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@effected/memfs": "catalog:effected",
		"@effected/semver": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"@savvy-web/bundler": "^2.2.1",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/semver": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"effect": "catalog:effect"
	},
	"peerDependenciesMeta": {
		"@effected/xdg": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
