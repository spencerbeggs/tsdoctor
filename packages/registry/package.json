{
	"name": "@tsdoctor/registry",
	"version": "0.7.2",
	"private": true,
	"description": "External TypeScript type loading for Effect: fetch, cache and resolve type definitions from npm via the jsDelivr CDN into a virtual file system.",
	"keywords": ["typescript", "vfs", "twoslash", "types", "jsdelivr", "cache", "effect"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/tsdoctor/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "packages/registry"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"effected-built": "./dist/prod/npm/pkg/index.js",
			"default": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/files": "catalog:effected",
		"@effected/package-json": "catalog:effected",
		"@effected/semver": "catalog:effected",
		"@tsdoctor/vfs": "workspace:*"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effect/vitest": "catalog:effected",
		"@effected/config-file": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/memfs": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@effected/tsconfig-json": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"effect": "catalog:effected",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/tsconfig-json": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"effect": "catalog:effected"
	},
	"peerDependenciesMeta": {
		"@effected/xdg": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
