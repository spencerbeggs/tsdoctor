{
	"name": "@tsdoctor/manifest",
	"version": "0.4.0",
	"private": true,
	"description": "Deprecated: re-exports @effected/manifest, the kit's spec-1 bundle.json manifest. Import from @effected/manifest instead.",
	"keywords": ["tsdoctor", "manifest", "api-extractor", "effect"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
