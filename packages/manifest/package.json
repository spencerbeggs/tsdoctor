{
	"name": "@tsdoctor/manifest",
	"version": "0.1.0",
	"private": true,
	"description": "The tsdoctor.json bundle manifest: the spec-1 schema, encode/decode boundaries and the authoring-file shape shared by bundlers that write it and readers that consume it.",
	"keywords": ["tsdoctor", "manifest", "api-extractor", "effect"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/tsdoctor/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "packages/manifest"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@savvy-web/bundler": "^2.2.0",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"effect": "catalog:effect"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
