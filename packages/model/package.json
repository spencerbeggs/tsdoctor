{
	"name": "@tsdoctor/model",
	"version": "0.8.0",
	"private": true,
	"description": "Render Microsoft API Extractor models into LLM-lean markdown. Pure model loading, TSDoc extraction, type-signature formatting, and per-item markdown rendering.",
	"keywords": ["api-extractor", "tsdoc", "llms", "documentation", "markdown", "typescript", "esm"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/tsdoctor/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "packages/model"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/yaml": "catalog:effected",
		"@microsoft/api-extractor-model": "catalog:build",
		"@microsoft/tsdoc": "~0.17.0",
		"@tsdoctor/vfs": "workspace:*"
	},
	"devDependencies": {
		"@effected/markdown": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/tsconfig-json": "catalog:effected",
		"@savvy-web/bundler": "^2.4.9",
		"@tsdoctor/snapshot": "workspace:*",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@effected/markdown": "catalog:effected:peers",
		"@effected/tsconfig-json": "catalog:effected:peers",
		"effect": "catalog:effect"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
