{
	"name": "@tsdoctor/model",
	"version": "0.10.4",
	"private": true,
	"description": "Render Microsoft API Extractor models into LLM-lean markdown. Pure model loading, TSDoc extraction, type-signature formatting, and per-item markdown rendering.",
	"keywords": ["api-extractor", "tsdoc", "llms", "documentation", "markdown", "typescript", "esm"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/tsdoctor/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "packages/model"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"effected-built": "./dist/prod/npm/pkg/index.js",
			"default": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/kit": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@microsoft/api-extractor-model": "catalog:effected:build",
		"@microsoft/tsdoc": "catalog:effected:build",
		"@tsdoctor/vfs": "workspace:*"
	},
	"devDependencies": {
		"@effected/glob": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/tsconfig-json": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@tsdoctor/snapshot": "workspace:*",
		"@types/node": "catalog:effected:build",
		"effect": "catalog:effected",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@effected/markdown": "catalog:effected:peers",
		"@effected/tsconfig-json": "catalog:effected:peers",
		"effect": "catalog:effected:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
