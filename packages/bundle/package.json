{
	"name": "@tsdoctor/bundle",
	"version": "0.9.2",
	"private": true,
	"description": "The tsdoctor bundle spec: layered bundle discovery, the versioned bundle.json sidecar manifest, provenance-carrying resolution and canonical input hashing for API documentation bundles.",
	"keywords": ["api-extractor", "bundle", "manifest", "documentation", "provenance", "typescript", "effect", "esm"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/tsdoctor/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "packages/bundle"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"effected-built": "./dist/prod/npm/pkg/index.js",
			"default": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/glob": "catalog:effected:exact",
		"@effected/images": "catalog:effected:exact",
		"@effected/walker": "catalog:effected:exact"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effect/vitest": "catalog:effected",
		"@effected/config-file": "catalog:effected",
		"@effected/github": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/manifest": "catalog:effected",
		"@effected/memfs": "catalog:effected",
		"@effected/npm": "catalog:effected",
		"@effected/package-json": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@effected/tsconfig-json": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"effect": "catalog:effected",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@effected/github": "catalog:effected:peers",
		"@effected/jsonc": "catalog:effected:peers",
		"@effected/manifest": "catalog:effected:peers",
		"@effected/npm": "catalog:effected:peers",
		"@effected/package-json": "catalog:effected:peers",
		"@effected/store": "catalog:effected:peers",
		"@effected/tsconfig-json": "catalog:effected:peers",
		"@effected/xdg": "catalog:effected:peers",
		"effect": "catalog:effected:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
