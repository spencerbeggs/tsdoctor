{
	"name": "@tsdoctor/snapshot",
	"version": "0.2.3",
	"private": true,
	"description": "Incremental-build snapshot tracking for static documentation pipelines: a schema-versioned SQLite store of per-file content hashes and timestamps, built on @effected/store, plus the pure SHA-256 content-hashing helpers that feed it.",
	"keywords": ["snapshot", "incremental-build", "sqlite", "content-hash", "effect", "documentation"],
	"homepage": "https://github.com/spencerbeggs/tsdoctor#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/tsdoctor/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/tsdoctor.git",
		"directory": "packages/snapshot"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effected/jsonc": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@savvy-web/bundler": "^2.1.30",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@effected/jsonc": "catalog:effected:peers",
		"@effected/store": "catalog:effected",
		"effect": "catalog:effect"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
